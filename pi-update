#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# Launch a dedicated Pi maintenance session for reviewing pi-patches against
# upstream Pi changelog changes. This intentionally does NOT install/update Pi.
#
# Usage:
#   pi-update [extra pi args...]
#
# Environment overrides:
#   PI_UPDATE_MODEL=gpt-5.5-fast
#   PI_UPDATE_THINKING=medium
#   PI_UPDATE_PROMPT_FILE=/path/to/prompt.md
# ---------------------------------------------------------------------------
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PI_BIN="$(command -v pi || true)"
CONFIG_FILE="${PI_UPDATE_CONFIG:-$HOME/.pi/agent/pi-update.env}"

if [ -z "$PI_BIN" ]; then
  echo "ERROR: pi not found on PATH. Install pi before running pi-update." >&2
  exit 1
fi

# Optional global profile. Example ~/.pi/agent/pi-update.env:
#   PI_UPDATE_MODEL=gpt-5.5-fast
#   PI_UPDATE_THINKING=medium
# Explicit environment variables from the shell win over this file.
_PRE_MODEL_SET="${PI_UPDATE_MODEL+x}"
_PRE_MODEL="${PI_UPDATE_MODEL-}"
_PRE_THINKING_SET="${PI_UPDATE_THINKING+x}"
_PRE_THINKING="${PI_UPDATE_THINKING-}"
_PRE_PROMPT_FILE_SET="${PI_UPDATE_PROMPT_FILE+x}"
_PRE_PROMPT_FILE="${PI_UPDATE_PROMPT_FILE-}"
if [ -f "$CONFIG_FILE" ]; then
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
fi
if [ -n "$_PRE_MODEL_SET" ]; then PI_UPDATE_MODEL="$_PRE_MODEL"; fi
if [ -n "$_PRE_THINKING_SET" ]; then PI_UPDATE_THINKING="$_PRE_THINKING"; fi
if [ -n "$_PRE_PROMPT_FILE_SET" ]; then PI_UPDATE_PROMPT_FILE="$_PRE_PROMPT_FILE"; fi

MODEL="${PI_UPDATE_MODEL:-}"
THINKING="${PI_UPDATE_THINKING:-medium}"
PROMPT_FILE="${PI_UPDATE_PROMPT_FILE:-$SCRIPT_DIR/PI_UPDATE_PROMPT.md}"

if [ ! -f "$PROMPT_FILE" ]; then
  echo "ERROR: pi-update prompt file not found: $PROMPT_FILE" >&2
  exit 1
fi
PROMPT="$(cat "$PROMPT_FILE")"

echo "→ Launching pi-update review session in $SCRIPT_DIR"
if [ -n "$MODEL" ]; then
  echo "→ Model: $MODEL, thinking: $THINKING"
else
  echo "→ Model: Pi default, thinking: $THINKING"
fi
echo "→ Prompt: $PROMPT_FILE"
echo "→ The editor will be prefilled; press Enter/Return when you want to send it."
cd "$SCRIPT_DIR"
export PI_UPDATE_PREFILL_PROMPT="$PROMPT"
if [ -n "$MODEL" ]; then
  exec "$PI_BIN" --model "$MODEL" --thinking "$THINKING" --extension "$SCRIPT_DIR/pi-update-prefill-extension.js" "$@"
else
  exec "$PI_BIN" --thinking "$THINKING" --extension "$SCRIPT_DIR/pi-update-prefill-extension.js" "$@"
fi
